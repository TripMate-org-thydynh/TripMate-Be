# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"        # "production" ở prod (bật CSP, CORS allowlist)
PORT=3000
ALLOWED_ORIGINS="https://app.tripmate.vn,https://tripmate.vn"  # CSV, dùng ở prod

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="đổi_bằng_chuỗi_ngẫu_nhiên_đủ_dài"
JWT_EXPIRES_IN="7d"

# Supabase (dùng cho /auth/login verify token; bỏ qua nếu chỉ dùng OTP/Google)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="..."

# Google OAuth (/auth/google)
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"

# ─── SMS OTP (Twilio) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ─── AI (Gemini, server-side only) ───────────────────────────────────────────
GEMINI_API_KEY="..."

# ─── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Dev only ────────────────────────────────────────────────────────────────
# Bật cửa hậu đăng nhập Google giả (mock-google-token). PHẢI để false/bỏ trống ở prod.
ALLOW_DEV_AUTH_BYPASS="false"

# --- Thanh toán gói Premium ---
# URL công khai của backend. Cổng thanh toán gọi IPN về đây, nên localhost
# không dùng được — khi phát triển hãy dùng ngrok/cloudflared.
PUBLIC_API_URL="https://api.tripmate.example.com"
# Nơi ví đẩy người dùng về sau khi trả xong. Để trống thì dùng deep link app.
PAYMENT_RETURN_URL="tripmate://premium/return"

# Momo — lấy tại https://business.momo.vn (sandbox: https://test-payment.momo.vn)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# ZaloPay — lấy tại https://merchant.zalopay.vn
# KEY1 dùng để ký lệnh tạo đơn, KEY2 để kiểm chữ ký callback. Không đổi chỗ.
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/create"

# Salt cho các tín hiệu chống lạm dụng dùng thử (email/thiết bị/dải mạng).
# Chỉ giá trị BĂM được lưu; salt phải là chuỗi ngẫu nhiên dài và không đổi —
# đổi salt sẽ làm mọi bản ghi cũ không đối chiếu được nữa.
TRIAL_SIGNAL_SALT=""
