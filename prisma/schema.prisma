generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String               @id @default(uuid()) @db.Uuid
  supabaseId       String               @unique @map("supabase_id") @db.Uuid
  email            String               @unique
  name             String
  username         String?              @unique
  passwordHash     String?              @map("password_hash")
  avatarUrl        String?              @map("avatar_url")
  bio              String?
  vibeTags         String[]             @map("vibe_tags")
  theme            String?              @default("dark")
  role             UserRole             @default(USER)
  isLocked         Boolean              @default(false) @map("is_locked")
  travelScore      Int                  @default(0) @map("travel_score")
  chaosScore       Int                  @default(0) @map("chaos_score")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  activities       Activity[]
  aiRequests       AIRequest[]
  chatMessagesSent ChatMessage[]
  expenseSplits    ExpenseSplit[]
  expensesPaid     Expense[]
  linkedBanks      LinkedBank[]
  media            Media[]
  messageReactions MessageReaction[]
  momentComments   MomentComment[]
  momentReactions  MomentReaction[]
  moments          Moment[]
  notifications    Notification[]
  paymentCards     PaymentCard[]
  paymentsReceived PaymentTransaction[] @relation("PaymentReceiver")
  paymentsSent     PaymentTransaction[] @relation("PaymentSender")
  pollVotes        PollVote[]
  pollsCreated     Poll[]
  tripMembers      TripMember[]
  tripsCreated     Trip[]               @relation("TripCreator")
  presence         UserPresence?
  wallet           UserWallet?
  fundContributions FundContribution[]
  wishlistItems    WishlistItem[]
  packingAdded     PackingItem[]        @relation("PackingAddedBy")
  packingAssigned  PackingItem[]        @relation("PackingAssignee")
  bucketItems      BucketItem[]
  reservations     Reservation[]
  todosAdded       TodoItem[]           @relation("TodoAddedBy")
  todosAssigned    TodoItem[]           @relation("TodoAssignee")
  invitesCreated   TripInvite[]
  notes            TripNote[]
  checkins         DayCheckin[]
  documents        TripDocument[]
  journalEntries   JournalEntry[]
  vacationDays     VacationDay[]

  @@map("users")
}

model UserPresence {
  userId        String         @id @map("user_id") @db.Uuid
  status        PresenceStatus @default(OFFLINE)
  currentTripId String?        @map("current_trip_id") @db.Uuid
  lastSeen      DateTime       @default(now()) @map("last_seen")
  latitude      Decimal?       @db.Decimal(10, 8)
  longitude     Decimal?       @db.Decimal(11, 8)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model Trip {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  destination   String?
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  coverImage    String?         @map("cover_image")
  inviteCode    String          @unique @map("invite_code")
  currency      String          @default("VND")
  budget        Decimal?        @db.Decimal(12, 2)
  vibe          String?
  theme         String?
  isPublic      Boolean         @default(false) @map("is_public")
  createdBy     String          @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  activities    Activity[]
  aiRequests    AIRequest[]
  budgetGoal    BudgetGoal?
  chatMessages  ChatMessage[]
  expenses      Expense[]
  gameSessions  GameSession[]
  itineraries   ItineraryItem[]
  moments       Moment[]
  notifications Notification[]
  polls         Poll[]
  members       TripMember[]
  creator       User            @relation("TripCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  fund          TripFund?
  wishlistItems WishlistItem[]
  packingItems  PackingItem[]
  reservations  Reservation[]
  todoItems     TodoItem[]
  invites       TripInvite[]
  notes         TripNote[]
  checkins      DayCheckin[]
  documents     TripDocument[]
  journalEntries JournalEntry[]

  @@map("trips")
}

model TripFund {
  id           String             @id @default(uuid()) @db.Uuid
  tripId       String             @unique @map("trip_id") @db.Uuid
  targetAmount Decimal            @map("target_amount") @db.Decimal(14, 2)
  deadline     DateTime?          @db.Date
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  trip         Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  contributions FundContribution[]

  @@map("trip_funds")
}

model FundContribution {
  id        String   @id @default(uuid()) @db.Uuid
  fundId    String   @map("fund_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now()) @map("created_at")
  fund      TripFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fund_contributions")
}

model WishlistItem {
  id        String         @id @default(uuid()) @db.Uuid
  tripId    String         @map("trip_id") @db.Uuid
  addedBy   String         @map("added_by") @db.Uuid
  type      String
  name      String
  address   String?
  link      String?
  notes     String?
  voteCount Int            @default(0) @map("vote_count")
  createdAt DateTime       @default(now()) @map("created_at")
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  votes     WishlistVote[]

  @@map("wishlist_items")
}

model WishlistVote {
  id        String       @id @default(uuid()) @db.Uuid
  itemId    String       @map("item_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  item      WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("wishlist_votes")
}

model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_members")
}

model ItineraryItem {
  id              String   @id @default(uuid()) @db.Uuid
  tripId          String   @map("trip_id") @db.Uuid
  day             Int
  startTime       String   @map("start_time")
  placeName       String   @map("place_name")
  placeAddress    String?  @map("place_address")
  placeId         String?  @map("place_id")
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  durationMinutes Int      @map("duration_minutes")
  notes           String?
  category        String?  @default("OTHER")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, day])
  @@map("itinerary_items")
}

model Expense {
  id          String               @id @default(uuid()) @db.Uuid
  tripId      String               @map("trip_id") @db.Uuid
  paidById    String               @map("paid_by") @db.Uuid
  amount      Decimal              @db.Decimal(12, 2)
  category    ExpenseCategory      @default(OTHER)
  description String?
  splitType   SplitType            @default(EQUAL)
  receiptUrl  String?              @map("receipt_url")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  splits      ExpenseSplit[]
  paidBy      User                 @relation(fields: [paidById], references: [id], onDelete: Cascade)
  trip        Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payments    PaymentTransaction[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([tripId, deletedAt, createdAt])
  @@map("expenses")
}

model ExpenseSplit {
  expenseId   String    @map("expense_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shareAmount Decimal   @map("share_amount") @db.Decimal(12, 2)
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@index([userId])
  @@index([userId, isPaid])
  @@map("expense_splits")
}

model PaymentTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  expenseId     String?         @map("expense_id") @db.Uuid
  senderId      String          @map("sender_id") @db.Uuid
  receiverId    String          @map("receiver_id") @db.Uuid
  amount        Decimal         @db.Decimal(12, 2)
  provider      PaymentProvider @default(CASH)
  status        PaymentStatus   @default(PENDING)
  transactionId String?         @map("transaction_id")
  note          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  expense       Expense?        @relation(fields: [expenseId], references: [id])
  receiver      User            @relation("PaymentReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User            @relation("PaymentSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([expenseId])
  @@map("payment_transactions")
}

model Media {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         MediaType
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  duration     Int?
  sizeBytes    Int?      @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment       Moment?

  @@index([userId])
  @@map("media")
}

model Moment {
  id        String           @id @default(uuid()) @db.Uuid
  tripId    String           @map("trip_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  mediaId   String?          @unique @map("media_id") @db.Uuid
  mediaUrl  String           @map("media_url")
  type      MomentType       @default(PHOTO)
  isGhost   Boolean          @default(false) @map("is_ghost")
  caption   String?
  latitude  Decimal?         @db.Decimal(10, 8)
  longitude Decimal?         @db.Decimal(11, 8)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  comments  MomentComment[]
  reactions MomentReaction[]
  media     Media?           @relation(fields: [mediaId], references: [id])
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([userId])
  @@map("moments")
}

model MomentComment {
  id        String    @id @default(uuid()) @db.Uuid
  momentId  String    @map("moment_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  moment    Moment    @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId])
  @@map("moment_comments")
}

model MomentReaction {
  momentId String @map("moment_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  emoji    String
  moment   Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([momentId, userId, emoji])
  @@index([momentId])
  @@map("moment_reactions")
}

model ChatMessage {
  id        String            @id @default(uuid()) @db.Uuid
  tripId    String            @map("trip_id") @db.Uuid
  senderId  String            @map("sender_id") @db.Uuid
  content   String?
  mediaUrl  String?           @map("media_url")
  type      MessageType       @default(TEXT)
  replyToId String?           @map("reply_to_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")
  replyTo   ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   ChatMessage[]     @relation("MessageReplies")
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@map("chat_messages")
}

model MessageReaction {
  messageId String      @map("message_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  emoji     String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Poll {
  id         String       @id @default(uuid()) @db.Uuid
  tripId     String       @map("trip_id") @db.Uuid
  createdBy  String       @map("created_by") @db.Uuid
  question   String
  isMultiple Boolean      @default(false) @map("is_multiple")
  closesAt   DateTime?    @map("closes_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  options    PollOption[]
  creator    User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("polls")
}

model PollOption {
  id     String     @id @default(uuid()) @db.Uuid
  pollId String     @map("poll_id") @db.Uuid
  text   String
  emoji  String?
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  optionId String     @map("option_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  votedAt  DateTime   @default(now()) @map("voted_at")
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tripId    String?          @map("trip_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  trip      Trip?            @relation(fields: [tripId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model GameSession {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  gameType  GameType @default(TRUTH_OR_DARE)
  stateJson Json     @map("state_json")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("game_sessions")
}

model AIRequest {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String?       @map("trip_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AIRequestType
  prompt    String
  response  Json?
  status    AIStatus      @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  trip      Trip?         @relation(fields: [tripId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([status])
  @@map("ai_requests")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  tripId    String       @map("trip_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  data      Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([userId])
  @@map("activities")
}

model LinkedBank {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  isVerified    Boolean  @default(true) @map("is_verified")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("linked_banks")
}

model PaymentCard {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  lastFour   String   @map("last_four")
  expiry     String
  cardHolder String   @map("card_holder")
  colorIndex Int      @default(0) @map("color_index")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_cards")
}

model UserWallet {
  userId           String   @id @map("user_id") @db.Uuid
  balanceMomo      Decimal  @default(2500000.0) @map("balance_momo") @db.Decimal(12, 2)
  balanceZalo      Decimal  @default(1200000.0) @map("balance_zalo") @db.Decimal(12, 2)
  balanceCash      Decimal  @default(500000.0) @map("balance_cash") @db.Decimal(12, 2)
  linkedBanksCount Int      @default(2) @map("linked_banks_count")
  creditCardsCount Int      @default(1) @map("credit_cards_count")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

model BudgetGoal {
  id                String   @id @default(uuid()) @db.Uuid
  tripId            String   @unique @map("trip_id") @db.Uuid
  limitAmount       Decimal  @default(15000000.0) @map("limit_amount") @db.Decimal(12, 2)
  warningPercentage Int      @default(80) @map("warning_percentage")
  categoryLimits    Json     @map("category_limits")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budget_goals")
}

model PackingItem {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  addedBy     String   @map("added_by") @db.Uuid
  name        String
  category    String   @default("OTHER")
  quantity    Int      @default(1)
  assignedTo  String?  @map("assigned_to") @db.Uuid
  isPacked    Boolean  @default(false) @map("is_packed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedByUser User     @relation("PackingAddedBy", fields: [addedBy], references: [id], onDelete: Cascade)
  assignee    User?    @relation("PackingAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("packing_items")
}

model TodoItem {
  id         String    @id @default(uuid()) @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  addedBy    String    @map("added_by") @db.Uuid
  title      String
  priority   String    @default("NORMAL")
  assignedTo String?   @map("assigned_to") @db.Uuid
  isDone     Boolean   @default(false) @map("is_done")
  dueDate    DateTime? @map("due_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedByUser User     @relation("TodoAddedBy", fields: [addedBy], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TodoAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("todo_items")
}

model TripInvite {
  id         String    @id @default(uuid()) @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid
  code       String    @unique
  expiresAt  DateTime? @map("expires_at")
  maxUses    Int?      @map("max_uses")
  useCount   Int       @default(0) @map("use_count")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator    User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([code])
  @@map("trip_invites")
}

model TripNote {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String?
  content   String
  color     String?  @default("#FFD84D")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_notes")
}

model DayCheckin {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  day       Int
  status    String   @default("GOING")
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, day])
  @@index([tripId])
  @@map("day_checkins")
}

model TripDocument {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  name        String
  url         String
  mimeType    String   @map("mime_type")
  sizeBytes   Int?     @map("size_bytes")
  linkedType  String?  @map("linked_type")
  linkedId    String?  @map("linked_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_documents")
}

model JournalEntry {
  id        String         @id @default(uuid()) @db.Uuid
  tripId    String         @map("trip_id") @db.Uuid
  authorId  String         @map("author_id") @db.Uuid
  title     String?
  body      String
  mood      String         @default("CHILL")
  entryDate DateTime       @map("entry_date") @db.Date
  latitude  Decimal?       @db.Decimal(10, 8)
  longitude Decimal?       @db.Decimal(11, 8)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  photos    JournalPhoto[]
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, entryDate])
  @@map("journal_entries")
}

model JournalPhoto {
  id       String       @id @default(uuid()) @db.Uuid
  entryId  String       @map("entry_id") @db.Uuid
  mediaUrl String       @map("media_url")
  caption  String?
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("journal_photos")
}

model VacationDay {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  type      String   @default("LEAVE")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("vacation_days")
}

model BucketItem {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bucket_items")
}

model Reservation {
  id                 String          @id @default(uuid()) @db.Uuid
  tripId             String          @map("trip_id") @db.Uuid
  addedBy            String          @map("added_by") @db.Uuid
  type               ReservationType @default(OTHER)
  title              String
  location           String?
  confirmationNumber String?         @map("confirmation_number")
  url                String?
  notes              String?
  status             String          @default("CONFIRMED")
  price              Decimal?        @db.Decimal(12, 2)
  startTime          DateTime?       @map("start_time")
  endTime            DateTime?       @map("end_time")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  trip               Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  addedByUser        User            @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([startTime])
  @@map("reservations")
}

