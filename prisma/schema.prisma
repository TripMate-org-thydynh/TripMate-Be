datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum TripRole {
  CREATOR
  MEMBER
}

enum ExpenseCategory {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITIES
  SHOPPING
  ENTERTAINMENT
  HEALTH
  COMMUNICATION
  OTHER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum GameType {
  TRUTH_OR_DARE
  CARD_MATCH
  SPIN_WHEEL
  TRIVIA
  WOULD_YOU_RATHER
}

enum MomentType {
  PHOTO
  VIDEO
  BOOMERANG
  GHOST_CAM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  POLL
  STICKER
  SYSTEM
}

enum NotificationType {
  TRIP_INVITE
  EXPENSE_ADDED
  DEBT_REMINDER
  MOMENT_REACTION
  COMMENT
  CHAT_MESSAGE
  POLL_CREATED
  GAME_STARTED
  TRIP_UPDATE
  PAYMENT_RECEIVED
  AI_READY
  ACHIEVEMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOMO
  VNPAY
  ZALOPAY
  BANK_TRANSFER
  CASH
}

enum AIRequestType {
  ITINERARY_PLAN
  VIBE_MATCH
  EXPENSE_ROAST
  CAPTION_GEN
  RECAP_VIDEO
  WEATHER_ADVICE
  DESTINATION_SUGGEST
  BUDGET_OPTIMIZE
}

enum AIStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActivityType {
  TRIP_CREATED
  MEMBER_JOINED
  MEMBER_LEFT
  ITINERARY_ADDED
  EXPENSE_ADDED
  MOMENT_SHARED
  GAME_STARTED
  POLL_CREATED
  PAYMENT_MADE
  CHAT_SENT
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum PresenceStatus {
  ONLINE
  OFFLINE
  IN_TRIP
  IDLE
}

// ============================================================
// USER SYSTEM
// ============================================================

model User {
  id          String   @id @default(uuid()) @db.Uuid
  supabaseId  String   @unique @map("supabase_id") @db.Uuid
  email       String   @unique
  name        String
  username    String?  @unique
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  vibeTags    String[] @map("vibe_tags")
  theme       String?  @default("dark")
  travelScore Int      @default(0) @map("travel_score")
  chaosScore  Int      @default(0) @map("chaos_score")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  tripsCreated       Trip[]               @relation("TripCreator")
  tripMembers        TripMember[]
  expensesPaid       Expense[]
  expenseSplits      ExpenseSplit[]
  moments            Moment[]
  momentComments     MomentComment[]
  momentReactions    MomentReaction[]
  chatMessagesSent   ChatMessage[]
  messageReactions   MessageReaction[]
  notifications      Notification[]
  presence           UserPresence?
  paymentsSent       PaymentTransaction[] @relation("PaymentSender")
  paymentsReceived   PaymentTransaction[] @relation("PaymentReceiver")
  aiRequests         AIRequest[]
  activities         Activity[]
  pollsCreated       Poll[]
  pollVotes          PollVote[]
  media              Media[]
  linkedBanks        LinkedBank[]
  paymentCards       PaymentCard[]
  wallet             UserWallet?

  @@map("users")
}

// User online/location presence for Live Trip Mode
model UserPresence {
  userId        String         @id @map("user_id") @db.Uuid
  status        PresenceStatus @default(OFFLINE)
  currentTripId String?        @map("current_trip_id") @db.Uuid
  lastSeen      DateTime       @default(now()) @map("last_seen")
  latitude      Decimal?       @db.Decimal(10, 8)
  longitude     Decimal?       @db.Decimal(11, 8)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

// ============================================================
// TRIP SYSTEM
// ============================================================

model Trip {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  coverImage  String?   @map("cover_image")
  inviteCode  String    @unique @map("invite_code")
  currency    String    @default("VND")
  theme       String?
  isPublic    Boolean   @default(false) @map("is_public")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  creator          User                 @relation("TripCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members          TripMember[]
  itineraries      ItineraryItem[]
  expenses         Expense[]
  moments          Moment[]
  gameSessions     GameSession[]
  chatMessages     ChatMessage[]
  polls            Poll[]
  activities       Activity[]
  aiRequests       AIRequest[]
  notifications    Notification[]
  budgetGoal       BudgetGoal?

  @@map("trips")
}

model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_members")
}

// ============================================================
// ITINERARY SYSTEM
// ============================================================

model ItineraryItem {
  id              String    @id @default(uuid()) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  day             Int
  startTime       String    @map("start_time")
  placeName       String    @map("place_name")
  placeAddress    String?   @map("place_address")
  placeId         String?   @map("place_id")
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  durationMinutes Int       @map("duration_minutes")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, day])
  @@map("itinerary_items")
}

// ============================================================
// EXPENSE & PAYMENT SYSTEM
// ============================================================

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  tripId      String          @map("trip_id") @db.Uuid
  paidById    String          @map("paid_by") @db.Uuid
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  description String?
  splitType   SplitType       @default(EQUAL)
  receiptUrl  String?         @map("receipt_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation(fields: [paidById], references: [id], onDelete: Cascade)
  splits       ExpenseSplit[]
  payments     PaymentTransaction[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@map("expenses")
}

model ExpenseSplit {
  expenseId   String    @map("expense_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shareAmount Decimal   @map("share_amount") @db.Decimal(12, 2)
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model PaymentTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  expenseId     String?         @map("expense_id") @db.Uuid
  senderId      String          @map("sender_id") @db.Uuid
  receiverId    String          @map("receiver_id") @db.Uuid
  amount        Decimal         @db.Decimal(12, 2)
  provider      PaymentProvider @default(CASH)
  status        PaymentStatus   @default(PENDING)
  transactionId String?         @map("transaction_id")
  note          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  sender   User     @relation("PaymentSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("PaymentReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([expenseId])
  @@map("payment_transactions")
}

// ============================================================
// MOMENTS / MEDIA SYSTEM
// ============================================================

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        MediaType
  url         String
  thumbnailUrl String?  @map("thumbnail_url")
  duration    Int?      // seconds for video/audio
  sizeBytes   Int?      @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment  Moment?

  @@index([userId])
  @@map("media")
}

model Moment {
  id        String     @id @default(uuid()) @db.Uuid
  tripId    String     @map("trip_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  mediaId   String?    @unique @map("media_id") @db.Uuid
  mediaUrl  String     @map("media_url")
  type      MomentType @default(PHOTO)
  isGhost   Boolean    @default(false) @map("is_ghost")
  caption   String?
  latitude  Decimal?   @db.Decimal(10, 8)
  longitude Decimal?   @db.Decimal(11, 8)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media?            @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  comments  MomentComment[]
  reactions MomentReaction[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([userId])
  @@map("moments")
}

model MomentComment {
  id        String    @id @default(uuid()) @db.Uuid
  momentId  String    @map("moment_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId])
  @@map("moment_comments")
}

model MomentReaction {
  momentId  String @map("moment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  emoji     String

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([momentId, userId, emoji])
  @@index([momentId])
  @@map("moment_reactions")
}

// ============================================================
// CHAT SYSTEM
// ============================================================

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  tripId    String      @map("trip_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  content   String?
  mediaUrl  String?     @map("media_url")
  type      MessageType @default(TEXT)
  replyToId String?     @map("reply_to_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[]     @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([tripId])
  @@index([tripId, createdAt])
  @@map("chat_messages")
}

model MessageReaction {
  messageId String @map("message_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  emoji     String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================================
// POLL SYSTEM
// ============================================================

model Poll {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  question  String
  isMultiple Boolean @default(false) @map("is_multiple")
  closesAt  DateTime? @map("closes_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  options PollOption[]

  @@index([tripId])
  @@map("polls")
}

model PollOption {
  id     String @id @default(uuid()) @db.Uuid
  pollId String @map("poll_id") @db.Uuid
  text   String
  emoji  String?

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  optionId String @map("option_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  votedAt  DateTime @default(now()) @map("voted_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

// ============================================================
// NOTIFICATION SYSTEM
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tripId    String?          @map("trip_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// GAME SYSTEM
// ============================================================

model GameSession {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  gameType  GameType  @default(TRUTH_OR_DARE)
  stateJson Json      @map("state_json")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("game_sessions")
}

// ============================================================
// AI SYSTEM
// ============================================================

model AIRequest {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String?       @map("trip_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AIRequestType
  prompt    String
  response  Json?
  status    AIStatus      @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([status])
  @@map("ai_requests")
}

// ============================================================
// ACTIVITY / AUDIT FEED
// ============================================================

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  tripId    String       @map("trip_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  data      Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, createdAt])
  @@index([userId])
  @@map("activities")
}

// ============================================================
// EXTENSIONS (MODULE 7 & PERSISTENCE)
// ============================================================

model LinkedBank {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  isVerified    Boolean  @default(true) @map("is_verified")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("linked_banks")
}

model PaymentCard {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String   // VISA, MASTERCARD, etc.
  lastFour    String   @map("last_four")
  expiry      String
  cardHolder  String   @map("card_holder")
  colorIndex  Int      @default(0) @map("color_index")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_cards")
}

model UserWallet {
  userId           String   @id @map("user_id") @db.Uuid
  balanceMomo      Decimal  @default(2500000.0) @map("balance_momo") @db.Decimal(12, 2)
  balanceZalo      Decimal  @default(1200000.0) @map("balance_zalo") @db.Decimal(12, 2)
  balanceCash      Decimal  @default(500000.0) @map("balance_cash") @db.Decimal(12, 2)
  linkedBanksCount Int      @default(2) @map("linked_banks_count")
  creditCardsCount Int      @default(1) @map("credit_cards_count")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

model BudgetGoal {
  id                String         @id @default(uuid()) @db.Uuid
  tripId            String         @unique @map("trip_id") @db.Uuid
  limitAmount       Decimal        @default(15000000.0) @map("limit_amount") @db.Decimal(12, 2)
  warningPercentage Int            @default(80) @map("warning_percentage")
  categoryLimits    Json           @map("category_limits")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budget_goals")
}
