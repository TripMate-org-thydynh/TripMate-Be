/// Sổ cái XP — mỗi dòng là một lần cộng hoặc trừ.
///
/// Số dư ở `users.xp_balance` là kết quả cộng dồn của bảng này. Giữ sổ cái để:
///   1. chống cộng trùng (unique userId+reason+refId),
///   2. tra được vì sao số dư ra con số đó khi người dùng thắc mắc,
///   3. dựng lại số dư nếu có sự cố.
model XpLedger {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// Dương = kiếm được, âm = đã tiêu.
  delta        Int
  reason       XpReason
  /// Id của thực thể sinh ra XP (moment, expense...). Cùng một thực thể chỉ
  /// được thưởng đúng một lần.
  refId        String?  @map("ref_id")
  tripId       String?  @map("trip_id") @db.Uuid
  /// Số dư ngay sau giao dịch — để đối chiếu khi cần soát.
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
  @@index([userId, reason, createdAt])
  @@map("xp_ledger")
}

enum XpReason {
  MOMENT_SHARED
  EXPENSE_ADDED
  ITINERARY_ADDED
  NOTE_ADDED
  JOURNAL_WRITTEN
  POLL_CREATED
  DOCUMENT_UPLOADED
  GAME_PLAYED
  STICKER_PURCHASE
  THEME_PURCHASE
  /// Thưởng cho người giới thiệu, mỗi lần một bạn mới nhập mã của họ.
  REFERRAL_SENT
  /// Thưởng cho người được giới thiệu, một lần duy nhất trong đời.
  REFERRAL_RECEIVED
  ADMIN_ADJUST
}

/// Sticker một người đã sở hữu. Sở hữu là nhị phân — mua rồi thì dùng bao nhiêu
/// lần cũng được, nên không đếm số lượng.
model UserSticker {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  stickerId  String   @map("sticker_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([userId])
  @@map("user_stickers")
}

/// Theme một người đã mở khoá.
model UserTheme {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  themeId    String   @map("theme_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@index([userId])
  @@map("user_themes")
}

/// Nhật ký thao tác nhạy cảm của Quản trị viên (Admin Audit Log).
/// Bắt buộc ghi lại mọi hành vi can thiệp thủ công (gia hạn, thu hồi gói, khoá tài khoản...)
/// kèm lý do để đối soát và phòng chống lạm dụng quyền hạn.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  reason     String
  details    Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
